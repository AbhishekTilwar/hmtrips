# Razorpay Configuration (REQUIRED for payments)
# Get these from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# API Configuration
VITE_API_BASE_URL=https://your-domain.com

# Application Settings
VITE_APP_NAME=HMTrips
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production

# Performance Optimization Settings
VITE_ENABLE_CACHE=true
VITE_CACHE_DURATION=300000
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_COMPRESSION=true

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_RECOMMENDATIONS=true
VITE_ENABLE_CRM=true
VITE_ENABLE_BEHAVIORAL_TRACKING=true

# Error Handling
VITE_LOG_LEVEL=warn
VITE_ENABLE_CONSOLE_LOGS=false

# Security Settings
VITE_ENABLE_CORS=true
VITE_RATE_LIMIT_ENABLED=true
VITE_MAX_REQUESTS_PER_MINUTE=100

# CDN Configuration (Optional)
VITE_CDN_URL=
VITE_ASSETS_CDN=

# Monitoring (Optional)
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=

# Admin Configuration
VITE_ADMIN_EMAIL=super@gmail.com

# Optimization Flags
VITE_ENABLE_CODE_SPLITTING=true
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_IMAGE_OPTIMIZATION=true
VITE_PRELOAD_CRITICAL_ASSETS=true

# Debug Settings (Keep false in production)
VITE_DEBUG_MODE=false
VITE_SHOW_PERFORMANCE_METRICS=false
